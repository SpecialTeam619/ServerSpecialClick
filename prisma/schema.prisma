generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
  LESSOR
}

enum StatusTechnique {
  IN_STOCK
  RENTED
}

enum StatusOrder {
  AWAITING
  REJECTED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
}

enum PaymentMode {
  SHIFT_7_PLUS_1
  HOURLY
}

model User {
  id       String @id @default(uuid())
  phone    String @unique
  name     String
  password String
  role     Role   @default(CUSTOMER)

  // Техника, которой владеет этот пользователь (если он арендодатель)
  techniques Technique[] @relation("UserTechniques")

  // Заказы, где пользователь выступает в роли заказчика
  customerOrders Order[] @relation("CustomerOrders")

  // Заказы, где пользователь выступает в роли арендодателя
  lessorOrders Order[] @relation("LessorOrders")

  chatMessages ChatMessage[]
}

model TechniqueType {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  photoUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  techniques Technique[]
}

model Technique {
  id              String          @id @default(uuid())
  ownerId         String
  owner           User            @relation("UserTechniques", fields: [ownerId], references: [id])
  name            String
  techniqueTypeId String
  techniqueType   TechniqueType   @relation(fields: [techniqueTypeId], references: [id])
  description     String
  photoUrl        String?
  property        String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  status          StatusTechnique @default(IN_STOCK)
  orders          Order[]
}

model Order {
  id         String      @id @default(uuid())
  customerId String
  customer   User        @relation("CustomerOrders", fields: [customerId], references: [id])
  lessorId   String
  lessor     User        @relation("LessorOrders", fields: [lessorId], references: [id])
  techniqueId String?
  technique   Technique? @relation(fields: [techniqueId], references: [id])
  status     StatusOrder @default(AWAITING)
  objectAddress String?
  arrivalAt DateTime?
  paymentMode PaymentMode?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  messages   ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  text      String
  createdAt DateTime @default(now())
}
